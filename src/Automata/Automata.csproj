<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Microsoft.Automata</RootNamespace>
    <AssemblyName>Microsoft.Automata</AssemblyName>
    <!-- Preserve the REX witness engine + GPPG parser code paths (legacy DefineConstants) -->
    <DefineConstants>$(DefineConstants);REX;EXPORT_GPPG</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>AutomataKey.snk</AssemblyOriginatorKeyFile>
    <Platforms>AnyCPU</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <!-- Pin to C# 12: the 2020 sources use 'field' as an ordinary identifier (CommandLineParser.cs:1593),
         which became a contextual keyword in C# 13+, binding to a synthesized backing field (CS9258/CS1061). -->
    <LangVersion>12.0</LangVersion>
    <Nullable>disable</Nullable>
    <!-- Legacy AssemblyInfo.cs is committed; do not auto-generate (avoids CS0579 duplicates) -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- BinaryFormatter/IFormatter serialization is legacy-obsolete in net8 (SYSLIB0011); the
         Automaton serialization path is not exercised by the regex-parser work, suppress for now. -->
    <NoWarn>$(NoWarn);CS0168;CS0219;CS0414;CS0649;CA1416;SYSLIB0011</NoWarn>
    <WarningsNotAsErrors>SYSLIB0011</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- System.CodeDom.Compiler.CompilerErrorCollection is type-forwarded here in net8 (T4 templates). -->
    <PackageReference Include="System.CodeDom" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- T4 templates are design-time; their generated .cs auto-include. Keep .tt as None. -->
    <None Include="Templates\**\*.tt" />
  </ItemGroup>

</Project>
